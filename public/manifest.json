{
  "manifest_version": 3,
  "name": "TabClipboard",
  "short_name": "TabClipboard",
  "version": "1.1.0",
  "description": "Copy all open web tab links or open links from the clipboard.",
  "minimum_chrome_version": "114",
  "permissions": [
    "tabs",
    "clipboardRead",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "TabClipboard",
    "default_popup": "popup/index.html"
  }
}
