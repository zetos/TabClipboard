{
  "manifest_version": 3,
  "name": "TabClipboard",
  "short_name": "TabClipboard",
  "version": "1.3.0",
  "description": "Copy web tab links from all windows or the current window, or open clipboard links.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "clipboardRead",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "TabClipboard",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
